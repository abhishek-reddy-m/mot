# --- Required ---
DATABASE_URL="postgresql://user:password@localhost:5432/hotelone"
DIRECT_URL="postgresql://user:password@localhost:5432/hotelone"   # unpooled URL for migrations (same as DATABASE_URL locally)
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Hotel defaults ---
HOTEL_TIMEZONE="America/Los_Angeles"
# NEXT_PUBLIC_DEMO_MODE="true"     # show one-click demo logins in production
# AGENT_PLAN_SECRET=""             # separate secret for signed agent plans
# NEXT_PUBLIC_SITE_URL=""          # canonical public address, e.g. https://hotelone.site (metadata, sitemap, Stripe return URLs)

# --- Voice front desk: ElevenLabs (preferred when set) or OpenAI GPT-Live ---
# ELEVENLABS_API_KEY=""          # HotelOne creates and syncs its ElevenLabs agents
# ELEVENLABS_VOICE_ID=""
# ELEVENLABS_LLM="gemini-2.5-flash"
# VOICE_PROVIDER="elevenlabs"      # or "openai"
# HOTELONE_PUBLIC_URL=""           # phone lines + booking links: public https address (default: NEXT_PUBLIC_SITE_URL, else the Vercel production domain); STAYOS_PUBLIC_URL still works
# ELEVENLABS_PHONE_AUDIO_FORMAT="ulaw_8000"   # or "auto"

# --- OpenAI: GPT-Live voice + PMS bridge operator ---
# OPENAI_API_KEY=""
# OPENAI_LIVE_MODEL="gpt-live-1"
# OPENAI_VOICE_BACKEND_MODEL="gpt-6-luna"
# BRIDGE_OPERATOR_MODEL="computer-use-preview"
# BRIDGE_OPERATOR_TOOL="computer_use_preview"   # or "computer"
# HOTELONE_VAULT_KEY=""            # openssl rand -base64 32 (required in production for cloud bridge logins); STAYOS_VAULT_KEY still works — keep the same value if you rename it
# BRIDGE_WORKER_SECRET=""          # enables the cloud worker

# --- Payments, email, uploads, sign-in (all optional) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# RESEND_API_KEY=""
# EMAIL_FROM="HotelOne <bookings@hotelone.site>"   # sender for confirmation emails (domain verified in Resend)
# BLOB_READ_WRITE_TOKEN=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Seeding ---
# ADMIN_SEED_PASSWORD=""
# DEMO_PASSWORD="demo1234"
# SEED_DEMO="true"
# ALLOW_SEED_WIPE="false"
