generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  address           String?
  city              String?
  state             String?
  zipCode           String?
  country           String?
  role              UserRole            @default(CUSTOMER)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  bookings          Booking[]
  // Properties assigned to this user (for Owner, Manager roles)
  assignedProperties UserPropertyAssignment[]
  // Housekeeping tasks assigned to this user
  housekeepingTasks  RoomHousekeeping[]
  // Channel agent chat sessions started by this user
  agentConversations AgentConversation[]

  @@map("users")
}

model Property {
  id          String          @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  state       String
  zipCode     String
  phone       String
  email       String?
  amenities   String[]
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  bookings    Booking[]
  photos      PropertyPhoto[]
  roomTypes   RoomType[]
  rooms       Room[]
  // Users assigned to this property
  assignedUsers UserPropertyAssignment[]
  // OTA connections (Expedia, Booking.com)
  channelConnections ChannelConnection[]

  @@map("properties")
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  publicId   String
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_photos")
}

model RoomType {
  id               String             @id @default(cuid())
  propertyId       String
  name             String
  description      String?
  capacity         Int
  basePrice        Decimal            @db.Decimal(10, 2)
  totalRooms       Int                @default(0)
  amenities        String[]
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  bookings         Booking[]
  roomAvailability RoomAvailability[]
  photos           RoomTypePhoto[]
  dailyRates       RoomTypeRate[]
  rooms            Room[]
  channelMappings      ChannelRoomMapping[]
  channelRateOverrides ChannelRateOverride[]
  property         Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("room_types")
}

model RoomAvailability {
  id          String   @id @default(cuid())
  roomTypeId  String
  date        DateTime
  totalRooms  Int
  bookedRooms Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
  @@map("room_availabilities")
}

model RoomTypePhoto {
  id         String   @id @default(cuid())
  roomTypeId String
  url        String
  publicId   String
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@map("room_type_photos")
}

model Booking {
  id            String                 @id @default(cuid())
  userId        String
  propertyId    String
  roomTypeId    String
  checkIn       DateTime
  checkOut      DateTime
  guests        Int
  rooms         Int                    @default(1)
  totalPrice    Decimal                @db.Decimal(10, 2)
  status        BookingStatus          @default(PENDING)
  notes         String?
  // Payment details (encrypted for security, stored for no-show charges)
  cardNumber    String?                // Encrypted full card number
  cardLast4     String?
  cardBrand     String?                // Visa, Mastercard, Amex, etc.
  cardExpMonth  Int?
  cardExpYear   Int?
  cardCvv       String?                // Encrypted CVV
  billingName   String?
  billingZip    String?
  // Where the booking came from (direct website or an OTA channel)
  source        BookingSource          @default(DIRECT)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  statusHistory BookingStatusHistory[]
  channelReservation ChannelReservation?
  property      Property               @relation(fields: [propertyId], references: [id])
  roomType      RoomType               @relation(fields: [roomTypeId], references: [id])
  user          User                   @relation(fields: [userId], references: [id])

  @@map("bookings")
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  status    BookingStatus
  notes     String?
  createdAt DateTime      @default(now())
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_status_history")
}

model RoomTypeRate {
  id         String   @id @default(cuid())
  roomTypeId String
  date       DateTime @db.Date
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
  @@map("room_type_rates")
}

enum UserRole {
  ADMIN
  OWNER
  MANAGER
  FRONT_DESK
  HOUSEKEEPER
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}

// Individual room with room number
model Room {
  id           String             @id @default(cuid())
  propertyId   String
  roomTypeId   String
  roomNumber   String
  floor        String?
  status       RoomStatus         @default(CLEAN)
  isOutOfOrder Boolean            @default(false)
  outOfOrderReason String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType     RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  housekeeping RoomHousekeeping[]

  @@unique([propertyId, roomNumber])
  @@map("rooms")
}

enum RoomStatus {
  CLEAN
  DIRTY
  INSPECTED
  OUT_OF_ORDER
}

// Housekeeping task for a room
model RoomHousekeeping {
  id          String              @id @default(cuid())
  roomId      String
  assignedTo  String?
  status      HousekeepingStatus  @default(PENDING)
  priority    Int                 @default(1)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  room        Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignee    User?               @relation(fields: [assignedTo], references: [id])

  @@map("room_housekeeping")
}

enum HousekeepingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  INSPECTED
}

// User-Property assignment for role-based access
model UserPropertyAssignment {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("user_property_assignments")
}

enum BookingSource {
  DIRECT
  EXPEDIA
  BOOKING_COM
}

// ============================================================================
// Channel Manager - OTA connectivity (Expedia, Booking.com)
// ============================================================================

enum OtaChannel {
  EXPEDIA
  BOOKING_COM
}

// SANDBOX simulates the OTA locally so onboarding can be tested without
// certified partner credentials. LIVE talks to the real OTA endpoints.
enum ChannelMode {
  SANDBOX
  LIVE
}

enum ChannelConnectionStatus {
  DRAFT // onboarding started, credentials not verified yet
  CONNECTED // credentials verified, room mapping in progress
  ACTIVE // mapped and syncing
  PAUSED // syncing suspended by an admin
  ERROR // last sync failed
}

// One property's connection to one OTA
model ChannelConnection {
  id                    String                  @id @default(cuid())
  propertyId            String
  channel               OtaChannel
  mode                  ChannelMode             @default(SANDBOX)
  status                ChannelConnectionStatus @default(DRAFT)
  // Expedia Hotel ID / Booking.com hotel_id
  otaPropertyId         String?
  otaPropertyName       String?
  // EQC username / Booking.com machine account
  username              String?
  password              String? // Encrypted
  currency              String                  @default("USD")
  // Added on top of the PMS rate before it is pushed (covers OTA commission)
  defaultMarkupPercent  Decimal                 @default(0) @db.Decimal(5, 2)
  syncRates             Boolean                 @default(true)
  syncAvailability      Boolean                 @default(true)
  importReservations    Boolean                 @default(true)
  syncWindowDays        Int                     @default(365)
  lastAriSyncAt         DateTime?
  lastReservationPullAt DateTime?
  lastError             String?
  activatedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  property              Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomMappings          ChannelRoomMapping[]
  rateOverrides         ChannelRateOverride[]
  promotions            ChannelPromotion[]
  reservations          ChannelReservation[]
  syncLogs              ChannelSyncLog[]

  @@unique([propertyId, channel])
  @@map("channel_connections")
}

// PMS room type <-> OTA room type + rate plan
model ChannelRoomMapping {
  id                  String            @id @default(cuid())
  connectionId        String
  roomTypeId          String
  otaRoomTypeId       String
  otaRoomTypeName     String?
  otaRatePlanId       String
  otaRatePlanName     String?
  // Overrides the connection's default markup when set
  markupPercent       Decimal?          @db.Decimal(5, 2)
  // Max rooms offered on this channel per night (null = everything available)
  inventoryAllocation Int?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  connection          ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  roomType            RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([connectionId, roomTypeId])
  @@map("channel_room_mappings")
}

// Channel-specific price / restrictions for a date. Wins over PMS rate + markup.
model ChannelRateOverride {
  id           String            @id @default(cuid())
  connectionId String
  roomTypeId   String
  date         DateTime          @db.Date
  price        Decimal?          @db.Decimal(10, 2)
  closed       Boolean           @default(false)
  minStay      Int?
  updatedBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  roomType     RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([connectionId, roomTypeId, date])
  @@index([date])
  @@map("channel_rate_overrides")
}

enum PromotionType {
  BASIC
  EARLY_BOOKER
  LAST_MINUTE
  MULTI_NIGHT
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
  FAILED
}

model ChannelPromotion {
  id               String            @id @default(cuid())
  connectionId     String
  // ID assigned by the OTA once the promotion is pushed
  externalId       String?
  name             String
  type             PromotionType
  discountPercent  Decimal           @db.Decimal(5, 2)
  stayStart        DateTime          @db.Date
  stayEnd          DateTime          @db.Date
  bookStart        DateTime?         @db.Date
  bookEnd          DateTime?         @db.Date
  minStay          Int?
  minDaysInAdvance Int? // EARLY_BOOKER
  maxDaysInAdvance Int? // LAST_MINUTE
  // PMS room types the promotion applies to (empty = every mapped room type)
  roomTypeIds      String[]
  status           PromotionStatus   @default(ACTIVE)
  lastError        String?
  createdBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  connection       ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, status])
  @@map("channel_promotions")
}

enum ChannelReservationStatus {
  BOOKED
  MODIFIED
  CANCELLED
}

// Reservation received from an OTA and the PMS booking created for it
model ChannelReservation {
  id           String                   @id @default(cuid())
  connectionId String
  externalId   String
  bookingId    String?                  @unique
  status       ChannelReservationStatus @default(BOOKED)
  guestName    String?
  totalAmount  Decimal?                 @db.Decimal(10, 2)
  currency     String?
  rawPayload   Json?
  receivedAt   DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  connection   ChannelConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  booking      Booking?                 @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalId])
  @@map("channel_reservations")
}

enum SyncLogStatus {
  SUCCESS
  FAILED
}

model ChannelSyncLog {
  id           String            @id @default(cuid())
  connectionId String
  action       String // CONNECTION_TEST, ROOM_FETCH, ARI_PUSH, RESERVATION_PULL, PROMOTION, ...
  status       SyncLogStatus
  message      String
  details      Json?
  createdAt    DateTime          @default(now())
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@map("channel_sync_logs")
}

// ============================================================================
// Channel Agent - AI assistant that manages rates and promotions
// ============================================================================

model AgentConversation {
  id        String           @id @default(cuid())
  userId    String
  title     String?
  // Claude Messages API history, append-only
  messages  Json             @default("[]")
  // Write actions waiting for the admin's approval
  pending   Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions   AgentActionLog[]

  @@index([userId, updatedAt])
  @@map("agent_conversations")
}

enum AgentActionStatus {
  EXECUTED
  REJECTED
  FAILED
}

// Audit trail of every change the agent proposed
model AgentActionLog {
  id             String            @id @default(cuid())
  conversationId String
  userId         String
  toolName       String
  input          Json
  result         Json?
  status         AgentActionStatus
  createdAt      DateTime          @default(now())
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("agent_action_logs")
}
