generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  address           String?
  city              String?
  state             String?
  zipCode           String?
  country           String?
  role              UserRole            @default(CUSTOMER)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  bookings          Booking[]
  // Properties assigned to this user (for Owner, Manager roles)
  assignedProperties UserPropertyAssignment[]
  // Housekeeping tasks assigned to this user
  housekeepingTasks  RoomHousekeeping[]

  @@map("users")
}

model Property {
  id          String          @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  state       String
  zipCode     String
  phone       String
  email       String?
  amenities   String[]
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  bookings    Booking[]
  photos      PropertyPhoto[]
  roomTypes   RoomType[]
  rooms       Room[]
  // Users assigned to this property
  assignedUsers UserPropertyAssignment[]

  @@map("properties")
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  publicId   String
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_photos")
}

model RoomType {
  id               String             @id @default(cuid())
  propertyId       String
  name             String
  description      String?
  capacity         Int
  basePrice        Decimal            @db.Decimal(10, 2)
  totalRooms       Int                @default(0)
  amenities        String[]
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  bookings         Booking[]
  roomAvailability RoomAvailability[]
  photos           RoomTypePhoto[]
  dailyRates       RoomTypeRate[]
  rooms            Room[]
  property         Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("room_types")
}

model RoomAvailability {
  id          String   @id @default(cuid())
  roomTypeId  String
  date        DateTime
  totalRooms  Int
  bookedRooms Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
  @@map("room_availabilities")
}

model RoomTypePhoto {
  id         String   @id @default(cuid())
  roomTypeId String
  url        String
  publicId   String
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@map("room_type_photos")
}

model Booking {
  id            String                 @id @default(cuid())
  userId        String
  propertyId    String
  roomTypeId    String
  checkIn       DateTime
  checkOut      DateTime
  guests        Int
  rooms         Int                    @default(1)
  totalPrice    Decimal                @db.Decimal(10, 2)
  status        BookingStatus          @default(PENDING)
  notes         String?
  // Payment metadata (no raw card data is ever stored — PCI compliance).
  // Card payments go through Stripe Checkout; otherwise pay at property.
  paymentStatus          String?               @default("UNPAID")
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  cardLast4     String?
  cardBrand     String?                // Visa, Mastercard, Amex, etc.
  billingName   String?
  billingZip    String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  statusHistory BookingStatusHistory[]
  property      Property               @relation(fields: [propertyId], references: [id])
  roomType      RoomType               @relation(fields: [roomTypeId], references: [id])
  user          User                   @relation(fields: [userId], references: [id])

  @@map("bookings")
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  status    BookingStatus
  notes     String?
  createdAt DateTime      @default(now())
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_status_history")
}

model RoomTypeRate {
  id         String   @id @default(cuid())
  roomTypeId String
  date       DateTime @db.Date
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
  @@map("room_type_rates")
}

enum UserRole {
  ADMIN
  OWNER
  MANAGER
  FRONT_DESK
  HOUSEKEEPER
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}

// Individual room with room number
model Room {
  id           String             @id @default(cuid())
  propertyId   String
  roomTypeId   String
  roomNumber   String
  floor        String?
  status       RoomStatus         @default(CLEAN)
  isOutOfOrder Boolean            @default(false)
  outOfOrderReason String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType     RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  housekeeping RoomHousekeeping[]

  @@unique([propertyId, roomNumber])
  @@map("rooms")
}

enum RoomStatus {
  CLEAN
  DIRTY
  INSPECTED
  OUT_OF_ORDER
}

// Housekeeping task for a room
model RoomHousekeeping {
  id          String              @id @default(cuid())
  roomId      String
  assignedTo  String?
  status      HousekeepingStatus  @default(PENDING)
  priority    Int                 @default(1)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  room        Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignee    User?               @relation(fields: [assignedTo], references: [id])

  @@map("room_housekeeping")
}

enum HousekeepingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  INSPECTED
}

// User-Property assignment for role-based access
model UserPropertyAssignment {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("user_property_assignments")
}
