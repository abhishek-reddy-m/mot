generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      UserRole  @default(CUSTOMER)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@map("users")
}

model Property {
  id          String          @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  state       String
  zipCode     String
  phone       String
  email       String?
  amenities   String[]
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  bookings    Booking[]
  photos      PropertyPhoto[]
  roomTypes   RoomType[]

  @@map("properties")
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  publicId   String
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_photos")
}

model RoomType {
  id               String             @id @default(cuid())
  propertyId       String
  name             String
  description      String?
  capacity         Int
  basePrice        Decimal            @db.Decimal(10, 2)
  totalRooms       Int                @default(0)
  amenities        String[]
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  bookings         Booking[]
  roomAvailability RoomAvailability[]
  photos           RoomTypePhoto[]
  dailyRates       RoomTypeRate[]
  property         Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("room_types")
}

model RoomAvailability {
  id          String   @id @default(cuid())
  roomTypeId  String
  date        DateTime
  totalRooms  Int
  bookedRooms Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
  @@map("room_availabilities")
}

model RoomTypePhoto {
  id         String   @id @default(cuid())
  roomTypeId String
  url        String
  publicId   String
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@map("room_type_photos")
}

model Booking {
  id            String                 @id @default(cuid())
  userId        String
  propertyId    String
  roomTypeId    String
  checkIn       DateTime
  checkOut      DateTime
  guests        Int
  rooms         Int                    @default(1)
  totalPrice    Decimal                @db.Decimal(10, 2)
  status        BookingStatus          @default(PENDING)
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  statusHistory BookingStatusHistory[]
  property      Property               @relation(fields: [propertyId], references: [id])
  roomType      RoomType               @relation(fields: [roomTypeId], references: [id])
  user          User                   @relation(fields: [userId], references: [id])

  @@map("bookings")
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  status    BookingStatus
  notes     String?
  createdAt DateTime      @default(now())
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_status_history")
}

model RoomTypeRate {
  id         String   @id @default(cuid())
  roomTypeId String
  date       DateTime @db.Date
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
  @@map("room_type_rates")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}
