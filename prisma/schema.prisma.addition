// BookedRoom - association between booking and specific room
model BookedRoom {
  id            String   @id @default(cuid())
  bookingId     String
  roomId        String  
  createdAt     DateTime @default(now())

  // Relations
  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    RoomInventory @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("booked_rooms")
}
