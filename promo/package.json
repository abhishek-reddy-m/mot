{
  "name": "casa-blanca-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Vertical promo video for Casa Blanca Hotels, built with Remotion",
  "type": "module",
  "scripts": {
    "audio": "node scripts/make-audio.ts",
    "fonts": "node scripts/copy-fonts.mjs",
    "studio": "remotion studio",
    "stills": "node scripts/render-stills.ts",
    "render": "remotion render Promo out/master.mp4 && node scripts/deliver.ts",
    "build": "npm run fonts && npm run audio && npm run stills && npm run render",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@fontsource/dancing-script": "5.2.7",
    "@fontsource/instrument-serif": "5.2.7",
    "@fontsource/inter": "5.2.7",
    "@fontsource/inter-tight": "5.2.7",
    "@fontsource/jetbrains-mono": "5.2.7",
    "@fontsource/montserrat": "5.2.7",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "typescript": "5.9.3"
  }
}
