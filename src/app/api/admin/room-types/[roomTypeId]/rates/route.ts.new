import { NextRequest, NextResponse } from 'next/server';
import { auth } from '@/lib/auth';
import { prisma } from '@/lib/prisma';
import { format } from 'date-fns';

// Define the RoomTypeRate interface
interface RoomTypeRate {
  id: string;
  roomTypeId: string;
  date: Date;
  price: number;
  createdAt: Date;
  updatedAt: Date;
}

// GET /api/admin/room-types/[roomTypeId]/rates
export async function GET(
  request: NextRequest,
  { params }: { params: { roomTypeId: string } }
) {
  try {
    const session = await auth();
    
    // Check authentication
    if (!session || session.user.role !== 'ADMIN') {
      return NextResponse.json(
        { error: 'Unauthorized' },
        { status: 401 }
      );
    }
    
    const { roomTypeId } = params;
    const searchParams = request.nextUrl.searchParams;
    const startDate = searchParams.get('startDate');
    const endDate = searchParams.get('endDate');
    
    // Validate dates
    if (!startDate || !endDate) {
      return NextResponse.json(
        { error: 'Start date and end date are required' },
        { status: 400 }
      );
    }
    
    // Query rates for the room type within the date range using raw SQL
    const rates = await prisma.$queryRaw<RoomTypeRate[]>`
      SELECT * FROM room_type_rates 
      WHERE room_type_id = ${roomTypeId}
      AND date >= ${new Date(startDate)}
      AND date <= ${new Date(endDate)}
      ORDER BY date ASC
    `;
    
    return NextResponse.json(rates);
  } catch (error) {
    console.error('Error fetching room type rates:', error);
    return NextResponse.json(
      { error: 'Failed to fetch room type rates' },
      { status: 500 }
    );
  }
}

// POST /api/admin/room-types/[roomTypeId]/rates
export async function POST(
  request: NextRequest,
  { params }: { params: { roomTypeId: string } }
) {
  try {
    const session = await auth();
    
    // Check authentication
    if (!session || session.user.role !== 'ADMIN') {
      return NextResponse.json(
        { error: 'Unauthorized' },
        { status: 401 }
      );
    }
    
    const { roomTypeId } = params;
    const body = await request.json();
    const { rates } = body;
    
    if (!rates || !Array.isArray(rates)) {
      return NextResponse.json(
        { error: 'Rates data is required and must be an array' },
        { status: 400 }
      );
    }
    
    // Process each rate in the array
    let successCount = 0;
    
    for (const rate of rates) {
      try {
        const { date, price } = rate;
        const formattedDate = format(new Date(date), 'yyyy-MM-dd');
        
        // Check if a rate already exists for this date
        const existingRates = await prisma.$queryRaw<RoomTypeRate[]>`
          SELECT * FROM room_type_rates 
          WHERE room_type_id = ${roomTypeId}
          AND date = ${formattedDate}::date
        `;
        
        const existingRate = existingRates.length > 0 ? existingRates[0] : null;
        
        if (existingRate) {
          // Update existing rate
          await prisma.$executeRaw`
            UPDATE room_type_rates
            SET price = ${price}, updated_at = NOW()
            WHERE id = ${existingRate.id}
          `;
        } else {
          // Create new rate with a generated ID
          const uuid = Date.now().toString(); // Simple ID generation
          await prisma.$executeRaw`
            INSERT INTO room_type_rates (id, room_type_id, date, price, created_at, updated_at)
            VALUES (${uuid}, ${roomTypeId}, ${formattedDate}::date, ${price}, NOW(), NOW())
          `;
        }
        
        successCount++;
      } catch (error) {
        console.error('Error processing rate:', error);
      }
    }
    
    return NextResponse.json({ success: true, count: successCount });
  } catch (error) {
    console.error('Error saving room type rates:', error);
    return NextResponse.json(
      { error: 'Failed to save room type rates' },
      { status: 500 }
    );
  }
}
