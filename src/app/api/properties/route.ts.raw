import { NextRequest, NextResponse } from 'next/server';
import { prisma } from '@/lib/prisma';

export async function GET(
  request: NextRequest
) {
  try {
    const searchParams = request.nextUrl.searchParams;
    const propertyId = searchParams.get('propertyId');
    const checkInParam = searchParams.get('checkIn');
    const checkOutParam = searchParams.get('checkOut');
    const guestsParam = searchParams.get('guests');
    
    // Parse search parameters with proper date handling
    let checkIn: Date | null = null;
    let checkOut: Date | null = null;
    
    if (checkInParam) {
      // Remove any cache-busting query params that might have been added
      const cleanCheckInParam = checkInParam.split('?')[0].trim();
      
      // Ensure the date is in YYYY-MM-DD format and set to noon UTC to avoid timezone issues
      checkIn = new Date(`${cleanCheckInParam}T12:00:00Z`);
      
      // Validate date is valid
      if (isNaN(checkIn.getTime())) {
        console.error(`Invalid check-in date format: ${cleanCheckInParam}`);
        checkIn = null;
      } else {
        console.log(`Using check-in date: ${cleanCheckInParam} (${checkIn.toISOString()})`);
      }
    }
    
    if (checkOutParam) {
      // Ensure the date is in YYYY-MM-DD format and set to noon UTC to avoid timezone issues
      const checkOutStr = checkOutParam.trim();
      checkOut = new Date(`${checkOutStr}T12:00:00Z`);
      
      // Validate date is valid
      if (isNaN(checkOut.getTime())) {
        console.error(`Invalid check-out date format: ${checkOutParam}`);
        checkOut = null;
      }
    }
    
    // If dates are valid, log them
    if (checkIn && checkOut) {
      if (checkIn >= checkOut) {
        console.warn('Check-in date must be before check-out date. Ignoring date filters.');
        checkIn = null;
        checkOut = null;
      }
    }
    
    const guests = guestsParam ? parseInt(guestsParam, 10) : null;
    
    console.log('Search parameters:', { 
      propertyId, 
      checkIn: checkIn?.toISOString(), 
      checkOut: checkOut?.toISOString(), 
      guests 
    });
    
    // Using raw SQL for the property query to completely avoid any ORM-related issues
    let propertiesQuery = `
      SELECT 
        p.id,
        p.name,
        p.description,
        p.address,
        p.city,
        p.state,
        p."zipCode",
        p.phone,
        p.email,
        p.amenities,
        p."isActive",
        p."createdAt",
        p."updatedAt"
      FROM properties p
      WHERE p."isActive" = true
    `;
    
    const queryParams: any[] = [];
    
    // Add property ID filter if provided
    if (propertyId) {
      propertiesQuery += ` AND p.id = $1`;
      queryParams.push(propertyId);
    }
    
    // Execute the raw query
    const propertiesResult = await prisma.$queryRaw`${prisma.$rawQueryString(propertiesQuery, ...queryParams)}`;
    
    // Ensure the result is an array
    const properties = Array.isArray(propertiesResult) ? propertiesResult : [];
    console.log(`Found ${properties.length} properties`);
    
    // For each property, get their photos and room types with separate queries
    const propertiesWithDetails = await Promise.all(properties.map(async (property: any) => {
      // Get main photo for this property
      const photosQuery = `
        SELECT url
        FROM property_photos
        WHERE "propertyId" = $1 AND "isMain" = true
        LIMIT 1
      `;
      
      const photosResult = await prisma.$queryRaw`${prisma.$rawQueryString(photosQuery, property.id)}`;
      const mainPhoto = Array.isArray(photosResult) && photosResult.length > 0 ? photosResult[0].url : null;
      
      // Get room types for this property
      let roomTypesQuery = `
        SELECT 
          rt.id,
          rt.name,
          rt.description,
          rt.capacity,
          rt."basePrice",
          rt."totalRooms",
          rt.amenities,
          rt."isActive",
          rt."createdAt",
          rt."updatedAt"
        FROM room_types rt
        WHERE rt."propertyId" = $1 AND rt."isActive" = true
      `;
      
      const roomTypesParams: any[] = [property.id];
      
      // Add guests filter if provided
      if (guests) {
        roomTypesQuery += ` AND rt.capacity >= $2`;
        roomTypesParams.push(guests);
      }
      
      const roomTypesResult = await prisma.$queryRaw`${prisma.$rawQueryString(roomTypesQuery, ...roomTypesParams)}`;
      const roomTypes = Array.isArray(roomTypesResult) ? roomTypesResult : [];
      
      // For each room type, get the main photo
      const roomTypesWithPhotos = await Promise.all(roomTypes.map(async (roomType: any) => {
        const roomPhotoQuery = `
          SELECT url
          FROM room_type_photos
          WHERE "roomTypeId" = $1 AND "isMain" = true
          LIMIT 1
        `;
        
        const roomPhotoResult = await prisma.$queryRaw`${prisma.$rawQueryString(roomPhotoQuery, roomType.id)}`;
        const mainPhoto = Array.isArray(roomPhotoResult) && roomPhotoResult.length > 0 ? roomPhotoResult[0].url : null;
        
        return {
          ...roomType,
          photos: mainPhoto ? [{ url: mainPhoto, isMain: true }] : []
        };
      }));
      
      return {
        ...property,
        photos: mainPhoto ? [{ url: mainPhoto, isMain: true }] : [],
        roomTypes: roomTypesWithPhotos
      };
    }));
    
    // Now calculate availability for the properties
    const propertiesWithAvailability = await Promise.all(propertiesWithDetails.map(async (property: any) => {
      let totalRooms = 0;
      let realAvailableRooms = 0;
      let lowestPrice: number | null = null;
      
      // For date-based availability, get room availability data
      let roomTypeAvailability: Record<string, Record<string, number>> = {};
      
      if (checkIn && checkOut) {
        // Get all room type IDs from this property
        const roomTypeIds = property.roomTypes.map((rt: any) => rt.id);
        
        if (roomTypeIds.length > 0) {
          // Get the date range
          const dateRange = getDateRange(checkIn, checkOut);
          
          // Initialize availability structure
          roomTypeIds.forEach(id => {
            roomTypeAvailability[id] = {};
            dateRange.forEach(date => {
              const dateStr = date.toISOString().split('T')[0];
              roomTypeAvailability[id][dateStr] = 0;
            });
          });
          
          // Fetch room availability records for these room types and dates
          const availabilityQuery = `
            SELECT 
              "roomTypeId",
              date,
              "bookedRooms"
            FROM room_availabilities
            WHERE "roomTypeId" IN (${roomTypeIds.map((_, i) => `$${i+1}`).join(',')})
              AND date >= $${roomTypeIds.length + 1}
              AND date < $${roomTypeIds.length + 2}
          `;
          
          const availabilityParams = [...roomTypeIds, checkIn, checkOut];
          
          const availabilityResult = await prisma.$queryRaw`${prisma.$rawQueryString(availabilityQuery, ...availabilityParams)}`;
          const availabilityRecords = Array.isArray(availabilityResult) ? availabilityResult : [];
          
          // Fill in actual booked rooms data
          availabilityRecords.forEach((record: any) => {
            const roomTypeId = record.roomTypeId;
            const dateStr = new Date(record.date).toISOString().split('T')[0];
            
            if (roomTypeAvailability[roomTypeId] && 
                dateRange.some(d => d.toISOString().split('T')[0] === dateStr)) {
              roomTypeAvailability[roomTypeId][dateStr] = record.bookedRooms;
            }
          });
        }
      }
      
      // Filter room types based on availability for selected dates
      const availableRoomTypes = property.roomTypes.filter((roomType: any) => {
        if (!checkIn || !checkOut) {
          return true; // No date filter, include all
        }
        
        // Calculate maximum bookings across date range
        let maxBookedRooms = 0;
        const dateRange = getDateRange(checkIn, checkOut);
        
        for (const date of dateRange) {
          const dateStr = date.toISOString().split('T')[0];
          const bookedRoomsForDate = roomTypeAvailability[roomType.id]?.[dateStr] || 0;
          maxBookedRooms = Math.max(maxBookedRooms, bookedRoomsForDate);
        }
        
        // Check if there's availability
        const realAvailable = Math.max(0, roomType.totalRooms - maxBookedRooms);
        
        // Store calculated availability for later use
        roomType.calculatedAvailableRooms = realAvailable;
        
        return realAvailable > 0;
      });
      
      // Calculate totals with available room types
      availableRoomTypes.forEach((roomType: any) => {
        totalRooms += roomType.totalRooms;
        realAvailableRooms += roomType.calculatedAvailableRooms || 0;
        
        // Track lowest price
        const basePrice = Number(roomType.basePrice);
        if (lowestPrice === null || basePrice < lowestPrice) {
          lowestPrice = basePrice;
        }
      });
      
      return {
        id: property.id,
        name: property.name,
        description: property.description,
        address: property.address,
        city: property.city,
        state: property.state,
        zipCode: property.zipCode,
        mainPhoto: property.photos[0]?.url || null,
        totalRooms,
        availableRooms: realAvailableRooms,
        lowestPrice,
        roomTypeCount: availableRoomTypes.length,
        hasAvailability: realAvailableRooms > 0
      };
    }));

    return NextResponse.json(propertiesWithAvailability);
  } catch (error) {
    console.error('Error fetching properties:', error);
    return NextResponse.json(
      { error: 'Internal server error' },
      { status: 500 }
    );
  }
}

// Helper function to get dates in a range
function getDateRange(start: Date, end: Date): Date[] {
  const dateRange: Date[] = [];
  const currentDate = new Date(start);
  
  // Normalize to start of day in UTC
  currentDate.setUTCHours(12, 0, 0, 0);
  
  // Get end date normalized to UTC noon as well for consistent comparison
  const endDateNorm = new Date(end);
  endDateNorm.setUTCHours(12, 0, 0, 0);
  
  console.log(`Getting date range from ${currentDate.toISOString()} to ${endDateNorm.toISOString()}`);
  
  while (currentDate < endDateNorm) {
    // Add a copy of the date to avoid reference issues
    dateRange.push(new Date(currentDate));
    currentDate.setDate(currentDate.getDate() + 1);
  }
  
  console.log(`Generated ${dateRange.length} dates in range`);
  
  // Safety check for empty ranges or invalid dates
  if (dateRange.length === 0 && start < end) {
    console.log("Empty date range detected despite valid start/end - adding single date as fallback");
    dateRange.push(new Date(start));
  }
  
  return dateRange;
}
