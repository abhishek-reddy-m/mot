{
  "name": "hotelone-instagram-reel",
  "version": "1.0.0",
  "private": true,
  "description": "Vertical Instagram Reel ad for HotelOne, built with Remotion",
  "type": "module",
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "voice": "python3 -I scripts/make-voice.py",
    "audio": "node scripts/make-audio.ts",
    "stills": "node scripts/render-stills.ts",
    "render": "remotion render Reel out/master.mp4 && node scripts/deliver.ts out/master.mp4 out/hotelone-reel.mp4 copy",
    "build": "npm run fonts && npm run audio && npm run stills && npm run render",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.2.8",
    "@fontsource/instrument-serif": "5.2.7",
    "@fontsource/inter": "5.2.7",
    "@fontsource/inter-tight": "5.2.7",
    "@fontsource/jetbrains-mono": "5.2.7",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "typescript": "5.9.3"
  }
}
